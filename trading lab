<script>

function calcLot(){

let balance=parseFloat(document.getElementById('balance').value);
let risk=parseFloat(document.getElementById('risk').value);
let stop=parseFloat(document.getElementById('stop').value);

if(!balance||!risk||!stop){
alert("Fill all fields");
return;
}

let riskMoney=balance*(risk/100);
let lot=riskMoney/(stop*10);

document.getElementById('lotResult').innerText=
lot.toFixed(2)+" Lots";
}

function calcRR(){

let entry=parseFloat(document.getElementById('entry').value);
let sl=parseFloat(document.getElementById('sl').value);
let tp=parseFloat(document.getElementById('tp').value);

if(!entry||!sl||!tp){
alert("Fill all fields");
return;
}

let risk=Math.abs(entry-sl);
let reward=Math.abs(tp-entry);

let rr=reward/risk;

document.getElementById('rrResult').innerText=
rr.toFixed(2)+" R";
}

function calcCompound(){

let p=parseFloat(document.getElementById('principal').value);
let r=parseFloat(document.getElementById('monthly').value)/100;
let m=parseFloat(document.getElementById('months').value);

if(!p||!r||!m){
alert("Fill all fields");
return;
}

let total=p*Math.pow((1+r),m);

document.getElementById('compoundResult').innerText=
"$"+total.toFixed(2);
}

</script>

