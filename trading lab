<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TradingLab | Trading Research Hub - Learn Trading, Manage Risk, Build Consistency</title>
    <meta name="description" content="Professional trading education, risk management, trading strategies, broker reviews, and free trading tools for Forex, Stocks, and Crypto traders.">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              brandDark: '#0B0E14',
              brandCard: '#151924',
              brandBorder: '#2A2E3D',
              brandAccent: '#2962FF',
              brandGreen: '#089981',
              brandRed: '#F23645'
            }
          }
        }
      }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-brandDark text-gray-200 font-sans antialiased selection:bg-brandAccent selection:text-white border-t-2 border-brandAccent">

    <!-- 顶部固定导航栏 -->
    <header class="sticky top-0 z-50 bg-brandDark/90 backdrop-blur-md border-b border-brandBorder">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="#" class="text-2xl font-black tracking-wider text-white flex items-center gap-2">
                <i data-lucide="candlestick-chart" class="text-brandAccent w-7 h-7"></i>
                TRADING<span class="text-brandAccent">LAB</span>
            </a>
            <nav class="hidden md:flex space-x-8 text-sm font-semibold text-gray-300">
                <a href="#home" class="hover:text-brandAccent transition">Home</a>
                <a href="#stories" class="hover:text-brandAccent transition">Trader Stories</a>
                <a href="#tools" class="hover:text-brandAccent transition">Trading Tools</a>
                <a href="#strategies" class="hover:text-brandAccent transition">Strategies</a>
                <a href="#faq" class="hover:text-brandAccent transition">FAQ</a>
            </nav>
            <a href="#tools" class="bg-brandAccent hover:bg-blue-600 text-white px-5 py-2 rounded-lg text-sm font-bold shadow-lg shadow-brandAccent/20 transition">Use Calculators</a>
        </div>
    </header>

    <!-- Hero 核心视觉区 -->
    <section id="home" class="relative py-20 px-4 text-center">
        <div class="max-w-4xl mx-auto">
            <span class="inline-block text-xs uppercase font-bold tracking-widest text-brandAccent bg-brandAccent/10 px-3 py-1 rounded-full border border-brandAccent/20 mb-6">Trading Research Hub</span>
            <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight mb-6">
                Learn Trading.<br>
                <span class="text-brandAccent">Manage Risk.</span><br>
                Build Consistency.
            </h1>
            <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-8">
                Professional trading education, risk management, trading strategies, broker reviews and free trading tools for Forex, Stocks and Crypto traders.
            </p>
            <div class="flex justify-center gap-4">
                <a href="#stories" class="bg-brandAccent hover:bg-blue-600 text-white px-6 py-3 rounded-xl font-bold transition">Read Trader Stories</a>
                <a href="#tools" class="bg-brandCard hover:bg-gray-800 text-white border border-brandBorder px-6 py-3 rounded-xl font-bold transition">Position Calculator</a>
            </div>
        </div>
    </section>

    <!-- 模块 1：奇迹交易员故事与大咖策略 (Stories & Strategies Section) -->
    <section id="stories" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-end mb-10">
            <div>
                <span class="text-xs font-bold text-brandAccent uppercase tracking-widest">Case Studies & Legends</span>
                <h2 class="text-3xl font-black text-white mt-1">Trader Stories & Breakdowns</h2>
            </div>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
            <!-- 卡片 1 -->
            <article class="bg-brandCard border border-brandBorder p-6 rounded-2xl hover:border-brandAccent transition">
                <span class="text-xs font-bold text-brandGreen bg-brandGreen/10 px-2.5 py-1 rounded">Trader Legend</span>
                <h3 class="text-xl font-bold text-white mt-4 mb-2">How Ross Cameron Turned $583 into $10M</h3>
                <p class="text-gray-400 text-sm mb-4">A deep dive into momentum penny stock breakouts, tape reading, and strict daily loss limits.</p>
                <a href="/posts/first-story" class="text-brandAccent text-sm font-bold hover:underline">Read Full Story &rarr;</a>
            </article>
            <!-- 卡片 2 -->
            <article class="bg-brandCard border border-brandBorder p-6 rounded-2xl hover:border-brandAccent transition">
                <span class="text-xs font-bold text-blue-400 bg-blue-400/10 px-2.5 py-1 rounded">Strategy Analysis</span>
                <h3 class="text-xl font-bold text-white mt-4 mb-2">Mark Minervini's VCP Pattern Masterclass</h3>
                <p class="text-gray-400 text-sm mb-4">How to spot Volatility Contraction Patterns before institutional breakout expansion.</p>
                <a href="#" class="text-brandAccent text-sm font-bold hover:underline">Read Analysis &rarr;</a>
            </article>
            <!-- 卡片 3 -->
            <article class="bg-brandCard border border-brandBorder p-6 rounded-2xl hover:border-brandAccent transition">
                <span class="text-xs font-bold text-purple-400 bg-purple-400/10 px-2.5 py-1 rounded">Risk & Psychology</span>
                <h3 class="text-xl font-bold text-white mt-4 mb-2">Why 90% of Day Traders Blow Up Accounts</h3>
                <p class="text-gray-400 text-sm mb-4">Analyzing revenge trading, over-leveraging, and how to build a mechanical trading plan.</p>
                <a href="#" class="text-brandAccent text-sm font-bold hover:underline">Read Article &rarr;</a>
            </article>
        </div>
    </section>

    <!-- 模块 2：辅助交易计算器工具区 (Tools Section) -->
    <section id="tools" class="py-16 bg-brandCard/40 border-y border-brandBorder">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-black text-white mb-8 text-center">Essential Trading Tools</h2>
            <div class="grid md:grid-cols-3 gap-6">
                <div class="bg-brandCard p-6 rounded-2xl border border-brandBorder">
                    <i data-lucide="calculator" class="text-brandAccent w-8 h-8 mb-4"></i>
                    <h3 class="text-xl font-bold text-white mb-2">Position Size Calculator</h3>
                    <p class="text-gray-400 text-sm mb-4">Calculate exact lot size based on risk percentage and stop loss pips.</p>
                    <a href="#calculator" class="text-brandAccent text-sm font-bold hover:underline">Launch Tool &rarr;</a>
                </div>
                <div class="bg-brandCard p-6 rounded-2xl border border-brandBorder">
                    <i data-lucide="scale" class="text-brandAccent w-8 h-8 mb-4"></i>
                    <h3 class="text-xl font-bold text-white mb-2">Risk Reward Calculator</h3>
                    <p class="text-gray-400 text-sm mb-4">Evaluate payout ratios to maintain a positive statistical expectancy.</p>
                    <a href="#" class="text-brandAccent text-sm font-bold hover:underline">Launch Tool &rarr;</a>
                </div>
                <div class="bg-brandCard p-6 rounded-2xl border border-brandBorder">
                    <i data-lucide="trending-up" class="text-brandAccent w-8 h-8 mb-4"></i>
                    <h3 class="text-xl font-bold text-white mb-2">Compound Growth Calculator</h3>
                    <p class="text-gray-400 text-sm mb-4">Simulate account equity curve growth with monthly target returns.</p>
                    <a href="#" class="text-brandAccent text-sm font-bold hover:underline">Launch Tool &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 页脚 Disclaimer & Copyright -->
    <footer class="py-12 border-t border-brandBorder text-center text-xs text-gray-500">
        <p class="mb-2">© 2026 TradingLab. All rights reserved.</p>
        <p class="max-w-xl mx-auto">Financial Disclaimer: Trading Forex, Stocks, and Crypto involves significant risk. TradingLab is an educational hub, not a financial advisor.</p>
    </footer>

    <script>lucide.createIcons();</script>
</body>
</html>
